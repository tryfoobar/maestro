appId: com.app.RunnrHost
---
# Not appearing known issue
- launchApp:
    clearState: true

- scrollUntilVisible:
    element: Reboot SDK
- tapOn: 🎲 Generate Random User ID
- doubleTapOn: Reboot SDK

- extendedWaitUntil:
    visible:
      text: Tooltip Marker
    timeout: 20000


- doubleTapOn: Guide/Survey Flag Key
- inputText: "survey-e2e-app-store-rating-724"
- tapOn: Show Guide/Survey


# in iOS image has no identifier
- assertVisible: App Store Rating
- tapOn: Done
- assertVisible: Tap a star to rate it on the App Store.
- tapOn: Not Now
